{
  "name": "linear-github-agent",
  "version": "1.0.0",
  "description": "A TypeScript server that integrates Linear Agents API with GitHub Codespaces for automated development environments",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently \"tsc --watch\" \"nodemon dist/server.js\"",
    "start": "node dist/server.js",
    "start:dev": "ts-node src/server.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'Linting not configured yet'",
    "test": "echo 'Tests not implemented yet'"
  },
  "keywords": [
    "linear",
    "github",
    "codespaces",
    "agent",
    "automation",
    "typescript"
  ],
  "author": "Linear GitHub Agent",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@linear/sdk": "^55.2.1",
    "@octokit/rest": "^22.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.2.1",
    "concurrently": "^9.2.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
