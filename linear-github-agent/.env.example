# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Linear API Configuration
LINEAR_API_KEY=your_linear_api_key_here

# GitHub API Configuration  
GITHUB_TOKEN=your_github_personal_access_token_here

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_PATH=/webhook/linear

# Codespace Configuration
DEFAULT_CODESPACE_MACHINE=basicLinux32gb
CODESPACE_IDLE_TIMEOUT_MINUTES=30

# Linear Workflow Configuration
IN_PROGRESS_STATE_NAMES=In Progress,Started,Working

# Security Configuration
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000

# Claude Configuration (for future use)
CLAUDE_API_KEY=your_claude_api_key_here