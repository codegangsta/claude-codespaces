# Linear GitHub Agent Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# API Keys (Required)
LINEAR_API_KEY=""
GITHUB_TOKEN=""

# Webhook Configuration (Required)
WEBHOOK_SECRET=""
WEBHOOK_PATH=/webhook/linear

# GitHub Codespace Configuration
DEFAULT_CODESPACE_MACHINE=standardLinux32gb
CODESPACE_IDLE_TIMEOUT_MINUTES=30

# Linear Configuration
IN_PROGRESS_STATE_NAMES=In Progress,Started,Working

# Security (Optional)
ALLOWED_ORIGINS=*

# Future Claude Integration (Optional)
CLAUDE_API_KEY=""